diff --git a/include/frg/printf.hpp b/include/frg/printf.hpp
index bce5e24..2ed0f65 100644
--- a/include/frg/printf.hpp
+++ b/include/frg/printf.hpp
@@ -784,7 +784,7 @@ void do_printf_ints(S &sink, Char t, format_options opts,
 	switch(t) {
 	case 'd':
 	case 'i': {
-		long number;
+		long long number; // not `long`: on ILP32 targets that truncated %lld/%lli to 32 bits
 		if(szmod == printf_size_mod::char_size) {
 			number = pop_arg<signed char>(vsp, &opts);
 		}else if(szmod == printf_size_mod::short_size) {
@@ -804,7 +804,7 @@ void do_printf_ints(S &sink, Char t, format_options opts,
 		if(opts.precision && *opts.precision == 0 && !number) {
 			pad_to_min();
 		}else{
-			_fmt_basics::print_int<S, long, Char>(sink, number, 10, opts.minimum_width,
+			_fmt_basics::print_int<S, long long, Char>(sink, number, 10, opts.minimum_width,
 					opts.precision ? *opts.precision : 1, opts.fill_zeros ? '0' : ' ',
 					opts.left_justify, opts.group_thousands, opts.always_sign,
 					opts.plus_becomes_space, false, locale_opts);
diff --git a/include/frg/sharded_slab.hpp b/include/frg/sharded_slab.hpp
